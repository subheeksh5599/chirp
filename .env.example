# Postgres (Neon) connection string
DATABASE_URL=
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Random string Telegram sends back on every webhook call
TELEGRAM_WEBHOOK_SECRET=
# Groq API key (live subtitles)
GROQ_API_KEY=
# TON testnet wallet that receives bills and presence anchors
TON_WALLET_ADDRESS=
# ed25519 private key, PKCS8 DER, base64 (signs presence records)
PRESENCE_SIGNING_KEY=
# Public origin of the deployment, e.g. https://your-app.vercel.app
PUBLIC_URL=
# Optional: raises toncenter's free rate limit
TONCENTER_API_KEY=
# Optional: testnet-only payer wallet for scripted runs; npm run payer -- new writes it
TON_PAYER_MNEMONIC=
