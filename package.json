{
  "name": "chirp",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bench:codec": "node scripts/codec-bench.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p . && npm run typecheck -w @chirp/glasses -w @chirp/web",
    "setup": "node --env-file=.env --import tsx scripts/setup.ts",
    "dev:api": "node --env-file=.env --import tsx server/local.ts",
    "dev:web": "npm run dev -w @chirp/web",
    "dev:glasses": "npm run dev -w @chirp/glasses",
    "build": "npm run build -w @chirp/web && npm run build -w @chirp/glasses",
    "e2e:room": "node --env-file=.env --import tsx scripts/e2e-room.ts",
    "e2e:note": "node --env-file=.env --import tsx scripts/e2e-note.ts",
    "check:whitelist": "node scripts/check-network-whitelist.mjs",
    "icon": "node scripts/make-icon.mjs",
    "bench:channels": "node scripts/channel-bench.mjs",
    "presence:live": "node --env-file=.env --import tsx scripts/presence-live.ts",
    "testnet": "node --env-file=.env --import tsx scripts/testnet-run.ts",
    "payer": "node --env-file=.env --import tsx scripts/testnet-payer.ts"
  },
  "devDependencies": {
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "@types/node": "^26.6.7",
    "ggwave": "0.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1"
  }
}
