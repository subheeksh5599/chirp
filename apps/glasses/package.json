{
  "name": "@chirp/glasses",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p .",
    "pack": "npm run build && evenhub pack app.json dist -o chirp.ehpk --sdk-ver 0.0.16",
    "build:hosted": "vite build --base /glasses/ --outDir ../web/dist/glasses --emptyOutDir"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "ggwave": "0.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "typescript": "^5.6.3",
    "vite": "^8.3.8"
  }
}
